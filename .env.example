# ----------------------------------------------------------------------------
# Nexora configuration. Copy to .env (`make up` does this automatically) and
# fill in real keys. Never commit .env.
# ----------------------------------------------------------------------------

# --- LLM key pool (required) --------------------------------------------------
# Comma-separated; ids are key_1, key_2, ... in this order. At least 2 for failover.
LLM_API_KEYS=your-provider-key-1,your-provider-key-2
# Any LiteLLM model string. Every key uses this model unless LLM_KEY_MODELS overrides it.
LLM_MODEL=gemini/gemini-2.5-flash
# Optional per-key models aligned with LLM_API_KEYS, e.g.
#   gemini/gemini-2.5-flash,groq/llama-3.3-70b-versatile
# Blank entries fall back to LLM_MODEL. Each key must belong to its model's provider.
LLM_KEY_MODELS=
# Per-attempt provider timeout (seconds) and optional output-token cap (empty = provider default).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=

# --- Storage --------------------------------------------------------------------
# SQLite file on the Docker volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# --- HTTP -----------------------------------------------------------------------
# Comma-separated CORS origins allowed to call the API (your frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# --- Cache (LiteLLM built-in, in-memory) ---------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEMS=1000

# --- Behaviour ------------------------------------------------------------------
# Leave empty to use the built-in default system prompt.
DEFAULT_SYSTEM_PROMPT=
LOG_LEVEL=INFO

# --- Frontend -------------------------------------------------------------------
# Runtime URL the browser uses to reach the backend (Docker frontend container).
API_BASE_URL=http://localhost:8000
# Build-time equivalent for Vercel / `npm run dev`.
VITE_API_BASE_URL=http://localhost:8000
